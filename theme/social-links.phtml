<?php // Rendered in place by a theme: $template['serviceBlock']('social-links'). Expects $osmiumSocialLinks (this
// service's own config). Prints nothing when no link is saved. Plain text links for a theme to style: each item
// carries data-network. A theme that wants icons renders its own list from OsmiumSocialLinksConfig::filled()
// instead of calling this block.
use Osmium\Services\OsmiumSocialLinks\Models\OsmiumSocialLinksConfig;

$saved = OsmiumSocialLinksConfig::filled($osmiumSocialLinks ?? []);
if (!$saved) return;
OsmiumSocialLinksConfig::noteShown(); // For the staff bar's "Social links" icon

$e = static fn(string $value): string => \htmlspecialchars($value);
?>
<ul class="social-links">
<?php foreach ($saved as $network => $url): ?>
    <li data-network="<?= $e($network) ?>"><a href="<?= $e($url) ?>" target="_blank" rel="noopener noreferrer"><?= $e(OsmiumSocialLinksConfig::NETWORKS[$network]) ?></a></li>
<?php endforeach; ?>
</ul>
